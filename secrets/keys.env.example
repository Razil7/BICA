# Образец. Скопируйте этот файл в secrets/keys.env и впишите свои ключи.
# Файл keys.env никому не отправляйте.
#
# Несколько ключей одного сервиса пишутся через запятую без пробелов:
# запросы чередуются между ними, дневные лимиты складываются.
#
# Gemini и Gemma: aistudio.google.com -> Get API key
GEMINI_API_KEY=ваш_ключ_1,ваш_ключ_2
# Groq (необязательно, нужен только для раздела 9): console.groq.com -> API Keys
GROQ_API_KEY=ваш_ключ_groq
